CPPDEFENSE_BACKEND_URL=https://cppdefense.example
CPPDEFENSE_RUNNER_TOKEN=REPLACE_WITH_THE_SAME_RUNNER_TOKEN_AS_BACKEND
CPPDEFENSE_RUNNER_ID=0199a123-4567-7abc-8def-0123456789ab
CPPDEFENSE_WORKER_PATH=/opt/cppdefense/bin/cpp-defense-worker
CPPDEFENSE_CONTAINER_RUNTIME=podman
CPPDEFENSE_SANDBOX_IMAGE=localhost/cppdefense-sandbox:2.1.0
CPPDEFENSE_JOB_TIMEOUT=5m
CPPDEFENSE_RUNNER_SLOTS=2
CPPDEFENSE_STORAGE_S3_ENDPOINT=192.168.100.10:9000
CPPDEFENSE_STORAGE_S3_REGION=us-east-1
CPPDEFENSE_STORAGE_S3_BUCKET=cppdefense
CPPDEFENSE_STORAGE_S3_ACCESS_KEY=REPLACE_WITH_RUNNER_READ_ONLY_ACCESS_KEY
CPPDEFENSE_STORAGE_S3_SECRET_KEY=REPLACE_WITH_RUNNER_READ_ONLY_SECRET_KEY
CPPDEFENSE_STORAGE_S3_SECURE=false
