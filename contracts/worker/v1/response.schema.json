{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cppdefense.example/schemas/worker/v1/response.schema.json",
  "title": "cpp-defense-worker response v1",
  "oneOf": [
    {
      "$ref": "#/$defs/analyzeOk"
    },
    {
      "$ref": "#/$defs/prepareOk"
    },
    {
      "$ref": "#/$defs/materializeOk"
    },
    {
      "$ref": "#/$defs/errorResponse"
    }
  ],
  "$defs": {
    "uuid": {
      "type": "string",
      "format": "uuid"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "allOf": [
        {
          "pattern": "^[^/\\\\\\u0000-\\u001f][^\\\\\\u0000-\\u001f]*$"
        },
        {
          "not": {
            "pattern": "(^|/)\\.\\.?(/|$)"
          }
        },
        {
          "not": {
            "pattern": "//"
          }
        }
      ]
    },
    "base": {
      "type": "object",
      "required": ["protocol_version", "request_id", "session_id", "command", "status"],
      "properties": {
        "protocol_version": {
          "const": "1.0"
        },
        "request_id": {
          "$ref": "#/$defs/uuid"
        },
        "session_id": {
          "$ref": "#/$defs/uuid"
        },
        "command": {
          "enum": ["analyze_project", "prepare_defense", "materialize_attempt"]
        },
        "status": {
          "enum": ["ok", "error"]
        }
      }
    },
    "errorBase": {
      "type": "object",
      "required": ["protocol_version", "request_id", "session_id", "command", "status"],
      "properties": {
        "protocol_version": {
          "const": "1.0"
        },
        "request_id": {
          "oneOf": [
            {"$ref": "#/$defs/uuid"},
            {"type": "null"}
          ]
        },
        "session_id": {
          "oneOf": [
            {"$ref": "#/$defs/uuid"},
            {"type": "null"}
          ]
        },
        "command": {
          "enum": ["analyze_project", "prepare_defense", "materialize_attempt", null]
        },
        "status": {
          "const": "error"
        }
      }
    },
    "functionCandidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "function_name",
        "file_path",
        "signature",
        "signature_begin",
        "body_begin",
        "body_end",
        "begin_line",
        "end_line",
        "line_count",
        "source_sha256"
      ],
      "properties": {
        "function_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "file_path": {
          "$ref": "#/$defs/relativePath"
        },
        "signature": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16384
        },
        "signature_begin": {
          "type": "integer",
          "minimum": 0
        },
        "body_begin": {
          "type": "integer",
          "minimum": 0
        },
        "body_end": {
          "type": "integer",
          "minimum": 0
        },
        "begin_line": {
          "type": "integer",
          "minimum": 1
        },
        "end_line": {
          "type": "integer",
          "minimum": 1
        },
        "line_count": {
          "type": "integer",
          "minimum": 1
        },
        "source_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "original_body_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "okBase": {
      "allOf": [
        {
          "$ref": "#/$defs/base"
        },
        {
          "type": "object",
          "required": ["result"],
          "properties": {
            "status": {
              "const": "ok"
            },
            "result": {
              "type": "object"
            }
          }
        }
      ]
    },
    "analyzeOk": {
      "allOf": [
        {
          "$ref": "#/$defs/okBase"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "protocol_version": {},
            "request_id": {},
            "session_id": {},
            "command": {
              "const": "analyze_project"
            },
            "status": {},
            "result": {
              "type": "object",
              "additionalProperties": false,
              "required": ["source_file_count", "function_count", "candidates"],
              "properties": {
                "source_file_count": {
                  "type": "integer",
                  "minimum": 0
                },
                "function_count": {
                  "type": "integer",
                  "minimum": 0
                },
                "candidates": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/functionCandidate"
                  }
                },
                "warnings": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/diagnostic"
                  }
                }
              }
            }
          }
        }
      ]
    },
    "prepareOk": {
      "allOf": [
        {
          "$ref": "#/$defs/okBase"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "protocol_version": {},
            "request_id": {},
            "session_id": {},
            "command": {
              "const": "prepare_defense"
            },
            "status": {},
            "result": {
              "type": "object",
              "additionalProperties": false,
              "required": ["candidates", "selected_index", "selected_function"],
              "properties": {
                "candidates": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 50,
                  "items": {
                    "$ref": "#/$defs/functionCandidate"
                  }
                },
                "selected_index": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 49
                },
                "selected_function": {
                  "$ref": "#/$defs/functionCandidate"
                },
                "warnings": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/diagnostic"
                  }
                }
              }
            }
          }
        }
      ]
    },
    "materializeOk": {
      "allOf": [
        {
          "$ref": "#/$defs/okBase"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "protocol_version": {},
            "request_id": {},
            "session_id": {},
            "command": {
              "const": "materialize_attempt"
            },
            "status": {},
            "result": {
              "type": "object",
              "additionalProperties": false,
              "required": ["output_root", "modified_file", "answer_sha256"],
              "properties": {
                "output_root": {
                  "$ref": "#/$defs/relativePath"
                },
                "modified_file": {
                  "$ref": "#/$defs/relativePath"
                },
                "answer_sha256": {
                  "$ref": "#/$defs/sha256"
                }
              }
            }
          }
        }
      ]
    },
    "diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]{1,63}$"
        },
        "message": {
          "type": "string",
          "maxLength": 4096
        },
        "file_path": {
          "$ref": "#/$defs/relativePath"
        },
        "line": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "errorResponse": {
      "allOf": [
        {
          "$ref": "#/$defs/errorBase"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["error"],
          "properties": {
            "protocol_version": {},
            "request_id": {},
            "session_id": {},
            "command": {},
            "status": {
              "const": "error"
            },
            "error": {
              "type": "object",
              "additionalProperties": false,
              "required": ["code", "message", "category", "retryable"],
              "properties": {
                "code": {
                  "type": "string",
                  "pattern": "^[A-Z][A-Z0-9_]{1,63}$"
                },
                "message": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4096
                },
                "category": {
                  "enum": ["invalid_request", "invalid_project", "conflict", "internal"]
                },
                "retryable": {
                  "type": "boolean"
                },
                "diagnostics": {
                  "type": "array",
                  "maxItems": 1000,
                  "items": {
                    "$ref": "#/$defs/diagnostic"
                  }
                }
              }
            }
          }
        }
      ]
    }
  }
}
