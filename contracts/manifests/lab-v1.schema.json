{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cppdefense.example/schemas/manifests/lab-v1.schema.json",
  "title": "CppDefense single lab import manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "group_code",
    "lab_code",
    "student",
    "project_path"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "kind": {
      "const": "lab"
    },
    "group_code": {
      "$ref": "#/$defs/code"
    },
    "lab_code": {
      "$ref": "#/$defs/code"
    },
    "student": {
      "$ref": "#/$defs/student"
    },
    "project_path": {
      "$ref": "#/$defs/projectPath"
    }
  },
  "$defs": {
    "code": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z0-9](?:[a-z0-9-]{0,62}[a-z0-9])?$"
    },
    "githubLogin": {
      "type": "string",
      "minLength": 1,
      "maxLength": 39,
      "pattern": "^(?!-)(?!.*--)[A-Za-z0-9](?:[A-Za-z0-9-]{0,37}[A-Za-z0-9])?$"
    },
    "projectPath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "allOf": [
        {
          "pattern": "^[^/\\\\\\u0000-\\u001f][^\\\\\\u0000-\\u001f]*$"
        },
        {
          "not": {
            "pattern": "(^|/)\\.\\.?(/|$)"
          }
        },
        {
          "not": {
            "pattern": "//"
          }
        }
      ]
    },
    "student": {
      "type": "object",
      "additionalProperties": false,
      "required": ["github_login"],
      "properties": {
        "github_login": {
          "$ref": "#/$defs/githubLogin"
        }
      }
    }
  }
}
