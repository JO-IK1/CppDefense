CPPDEFENSE_HTTP_ADDRESS=127.0.0.1:8080
CPPDEFENSE_PUBLIC_ORIGIN=http://localhost:8080
CPPDEFENSE_DATABASE_URL=postgres://cppdefense:cppdefense-local-only@127.0.0.1:5432/cppdefense?sslmode=disable
CPPDEFENSE_DATABASE_MAX_CONNECTIONS=10
CPPDEFENSE_DATABASE_MIN_CONNECTIONS=1
CPPDEFENSE_SESSION_HASH_KEY=REPLACE_WITH_BASE64URL_32_BYTES
CPPDEFENSE_CSRF_HASH_KEY=REPLACE_WITH_ANOTHER_BASE64URL_32_BYTES
CPPDEFENSE_SESSION_TTL=24h
CPPDEFENSE_OAUTH_FLOW_KEY=REPLACE_WITH_A_THIRD_BASE64URL_32_BYTES
CPPDEFENSE_OAUTH_FLOW_TTL=10m
CPPDEFENSE_GITHUB_CLIENT_ID=REPLACE_WITH_GITHUB_OAUTH_APP_CLIENT_ID
CPPDEFENSE_GITHUB_CLIENT_SECRET=REPLACE_WITH_GITHUB_OAUTH_APP_CLIENT_SECRET
CPPDEFENSE_BOOTSTRAP_ADMIN_GITHUB_ID=REPLACE_WITH_YOUR_NUMERIC_GITHUB_ID
CPPDEFENSE_RUNNER_TOKEN=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
CPPDEFENSE_STORAGE_MODE=s3
CPPDEFENSE_STORAGE_LOCAL_ROOT=./var/objects
CPPDEFENSE_STORAGE_S3_ENDPOINT=127.0.0.1:9000
CPPDEFENSE_STORAGE_S3_REGION=us-east-1
CPPDEFENSE_STORAGE_S3_BUCKET=cppdefense
CPPDEFENSE_STORAGE_S3_ACCESS_KEY=cppdefense-local
CPPDEFENSE_STORAGE_S3_SECRET_KEY=cppdefense-local-secret-change-me
CPPDEFENSE_STORAGE_S3_SECURE=false
CPPDEFENSE_STORAGE_SPOOL_DIR=./var/spool
CPPDEFENSE_AUTO_MIGRATE=true
CPPDEFENSE_LOG_LEVEL=debug
